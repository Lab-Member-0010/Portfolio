# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.
APP_NAME="Jayesh Sharma Portfolio API"

# Local: SQLite file. Production: Neon pooled connection string (postgres:// or postgresql:// both work)
DATABASE_URL=sqlite:///./portfolio.db
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
# Used only when the database is first created; change the password later in Admin → Account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Comma-separated, exact origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max PDF upload size. Keep at 4 on Vercel (platform request limit is ~4.5 MB)
MAX_RESUME_MB=10

# Vercel Blob — added automatically when you connect a Blob store. When set, PDFs go to Blob.
# BLOB_READ_WRITE_TOKEN=

# Local disk storage + serving the built React app (ignored on Vercel)
UPLOAD_DIR=./uploads
FRONTEND_DIST=../frontend/dist
