# Copy to .env and change before deploying
APP_NAME="Jayesh Sharma Portfolio API"
DATABASE_URL=sqlite:///./portfolio.db
# For Postgres: postgresql+psycopg://user:pass@localhost:5432/portfolio  (pip install "psycopg[binary]")
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=./uploads
# Optional: serve the built React app (frontend/dist) from FastAPI
FRONTEND_DIST=../frontend/dist
