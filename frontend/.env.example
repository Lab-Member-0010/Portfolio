# Production (Vercel → frontend project → Environment Variables):
# the backend project's URL, without /api and without a trailing slash.
VITE_API_URL=
# e.g. VITE_API_URL=https://jayesh-portfolio-api.vercel.app

# Local development only: where `npm run dev` proxies /api
VITE_PROXY_TARGET=http://127.0.0.1:8000
